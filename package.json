    "eslint-plugin-react-refresh": "0.4.6",
    "eslint-plugin-storybook": "9.0.7",
    "globals": "15.12.0",
    "prettier": "3.6.2",
    "storybook": "8.4.0",
    "typescript": "5.2.2",
    "vite": "5.4.10",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lib-inject-css": "2.2.2"
