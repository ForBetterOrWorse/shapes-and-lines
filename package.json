{
  "name": "@forbetterorworse/shapes-and-lines",
  "engines": {
    "node": "20",
    "pnpm": "9"
  },
  "scripts": {
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc",
    "prettier": "prettier . --write",
    "build:react": "cd packages/react && tsc && vite build",
    "storybook:react": "cd packages/react && pnpm run storybook",
    "build-storybook:react": "cd packages/react && pnpm run build-storybook",
    "build": "pnpm run build:react",
    "build-storybook": "pnpm run build-storybook:react"
  },
  "devDependencies": {
    "@eslint/compat": "1.1.1",
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.9.0",
    "@types/lodash": "4.17.4",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "8.2.0",
    "@typescript-eslint/parser": "8.2.0",
    "@vitejs/plugin-react": "4.2.1",
    "eslint": "9.9.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.6",
    "eslint-plugin-storybook": "0.8.0",
    "globals": "15.9.0",
    "prettier": "3.2.5",
    "typescript": "5.2.2",
    "vite": "5.2.0",
    "vite-plugin-dts": "4.0.3",
    "vite-plugin-lib-inject-css": "2.1.1"
  }
}
