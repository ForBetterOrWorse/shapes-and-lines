{
  "name": "@forbetterorworse/shapes-and-lines",
  "description": "A React library that randomly generates shapes and lines.",
  "version": "0.3.1",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
